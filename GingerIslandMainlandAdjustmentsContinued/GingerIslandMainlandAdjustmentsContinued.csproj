<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>GingerIslandMainlandAdjustmentsContinued</AssemblyName>
    <RootNamespace>GingerIslandMainlandAdjustments</RootNamespace>
    <Version>1.2.1</Version>
    <EnableHarmony>true</EnableHarmony>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GamePath>$(STARDEW_GAME_DIR)</GamePath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**;[[]CP[]]*/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
    <PackageReference Include="Pathoschild.Stardew.ModTranslationClassBuilder" Version="2.2.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GingerIslandMainlandAdjustmentsContinued.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="StardewValley" />
    <Using Include="StardewModdingAPI" />
    <Using Include="StardewValley.Extensions" />
    <Using Include="GingerIslandMainlandAdjustments.Framework" />
    <Using Include="System.Diagnostics.CodeAnalysis" />
    <Using Alias="NotNullAttribute" Include="System.Diagnostics.CodeAnalysis.NotNullAttribute" />
    <Using Alias="Object" Include="System.Object" />
    <Using Alias="SObject" Include="StardewValley.Object" />
  </ItemGroup>

  <!-- the CP manifest has a literal version, so only require it to match for release (non-prerelease) builds -->
  <ItemGroup Condition="!$(Version.Contains('-'))">
    <ContentPacks Include="%5BCP%5D Ginger Island Mainland Adjustments" Version="$(Version)" />
  </ItemGroup>
  <ItemGroup Condition="$(Version.Contains('-'))">
    <ContentPacks Include="%5BCP%5D Ginger Island Mainland Adjustments" ValidateManifest="false" />
  </ItemGroup>

  <PropertyGroup>
    <TranslationClassBuilder_AddGetByKey>true</TranslationClassBuilder_AddGetByKey>
  </PropertyGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
	  <AssemblyName>ProfitCalculator</AssemblyName>
	  <RootNamespace>ProfitCalculator</RootNamespace>
	  <Version>2.1.0</Version>
	  <EnableHarmony>false</EnableHarmony>
	  <GamePath>$(STARDEW_GAME_DIR)</GamePath>
	  <GenerateDocumentationFile>true</GenerateDocumentationFile>
	  <!-- the XML docs are for development; don't ship them to players -->
	  <IgnoreModFilePatterns>\.xml$</IgnoreModFilePatterns>
	  <!-- keep generated files out of the compile globs even when obj/bin are redirected (parallel builds) -->
	  <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>

	<ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
  </ItemGroup>

</Project>

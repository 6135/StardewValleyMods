<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
	  <AssemblyName>ProfitCalculator</AssemblyName>
	  <RootNamespace>ProfitCalculator</RootNamespace>
	  <Version>2.1.0</Version>
	  <EnableHarmony>true</EnableHarmony>
	  <GamePath>$(STARDEW_GAME_DIR)</GamePath>
	  <GenerateDocumentationFile>true</GenerateDocumentationFile>
	  <!-- keep generated files out of the compile globs even when obj/bin are redirected (parallel builds) -->
	  <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="manualCrops.json\**" />
    <EmbeddedResource Remove="manualCrops.json\**" />
    <None Remove="FakesAssemblies\**" />
    <None Remove="manualCrops.json\**" />
  </ItemGroup>
	
	<ItemGroup>
		<None Include="i18n\default.json" />
		<!-- the data-driven screens (UI Framework data imported at launch, see ProfitCalculatorDataUI) -->
		<None Include="assets\ui.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
  </ItemGroup>

</Project>

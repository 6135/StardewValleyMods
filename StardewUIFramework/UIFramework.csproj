<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>UIFramework</AssemblyName>
    <RootNamespace>UIFramework</RootNamespace>
    <Version>1.8.0</Version>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableHarmony>false</EnableHarmony>
    <GamePath>$(STARDEW_GAME_DIR)</GamePath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML docs on internal-facing members is acceptable. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- keep generated files out of the compile globs even when obj/bin are redirected (parallel builds) -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="assets\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Api\Public\IStardewUIApi.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- data-driven UIs (v1.3): the JSON models use SMAPI's own Newtonsoft.Json (not bundled with the mod) -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GamePath)\smapi-internal\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>UIFramework</AssemblyName>
    <RootNamespace>UIFramework</RootNamespace>
    <Version>1.1.0</Version>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableHarmony>false</EnableHarmony>
    <GamePath>$(STARDEW_GAME_DIR)</GamePath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML docs on internal-facing members is acceptable. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- keep generated files out of the compile globs even when obj/bin are redirected (parallel builds) -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="i18n\default.json" />
    <None Include="assets\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Api\Public\IStardewUIApi.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StardewUIFramework.Tests" />
  </ItemGroup>

</Project>
